<?xml version="1.0"?>
<package format="2">

  <name>pairs_octomap_server</name>
  <version>1.0.0</version>
  <description>PAIRS OctoMap Server</description>

  <maintainer email="canhthanh@vnu.edu.vn">Thanh Nguyen Canh</maintainer>
